# Copy this file to .env and fill in your key.
# Get one at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# For autonomous account creation on Workday etc. — the agent reads the
# verification email over IMAP. Use a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT your real password. Read-only use; nothing is sent or deleted.
JOBAGENT_EMAIL=
JOBAGENT_EMAIL_APP_PASSWORD=
# JOBAGENT_IMAP_HOST=imap.gmail.com
