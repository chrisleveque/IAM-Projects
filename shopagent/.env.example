# Anthropic API key — required for agents to reason (works even in dry_run mode).
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Shopify app credentials — see README "Connect your Shopify store".
# Apps are created in the Dev Dashboard (dev.shopify.com); copy the Client ID
# and Client secret from the app's Settings page. shopagent exchanges them for
# short-lived Admin API tokens automatically (cached in .shopify_token.json).
# Leave blank to run against the built-in mock store.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Legacy alternative: a permanent shpat_ Admin API token from a custom app
# created before 2026. If set, it takes precedence over client credentials.
SHOPIFY_ACCESS_TOKEN=

# CJ Dropshipping API credentials — see README "Connect CJ Dropshipping".
# Leave blank to run against the built-in mock supplier catalog.
CJ_EMAIL=
CJ_API_KEY=

# Amazon SP-API credentials — see README "Adding the Amazon channel".
# From your self-authorized app in Seller Central (Partner Network -> Develop
# Apps): LWA Client ID + Client Secret, and the refresh token shown when you
# authorize the app. AMZ_SELLER_ID is your Merchant Token (Settings ->
# Account Info -> Merchant Token). Leave blank to use the mock Amazon backend.
AMZ_CLIENT_ID=
AMZ_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_SELLER_ID=

# Bearer token for the HTTP API (`shopagent serve`) — see README "Remote
# control from your phone (n8n)". Any caller holding this can approve actions
# that spend money and email customers, so use 32+ random characters and never
# commit it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required only if you run `shopagent serve`; the CLI works without it.
SHOPAGENT_API_TOKEN=

# Royalty-free music for video ads. Either provider alone is enough; Jamendo's
# API is the documented one, Pixabay's music endpoint is best-effort.
#   Jamendo:  https://devportal.jamendo.com  (free client id)
#   Pixabay:  https://pixabay.com/api/docs/  (free key)
# Leave blank to use the built-in mock catalogue (renders a silent bed).
PIXABAY_API_KEY=
JAMENDO_CLIENT_ID=

# JSON2Video — the professional cloud render engine for video ads. Free tier
# (600 credits, no card) at json2video.com; the key is in your dashboard.
# With this set, `tiktok.render_video` uses their motion-graphics editor
# (animated text, transitions, built-in voiceover); without it, the local
# ffmpeg renderer is used. Override via config.yaml video.engine.
JSON2VIDEO_API_KEY=

# Google Gemini API key — powers Veo UGC video ad generation (`shopagent
# veo`). Create one free at https://aistudio.google.com/apikey. Veo bills
# per second of output video to the Google account behind the key (roughly
# $0.15/s fast, $0.40/s standard — see `shopagent veo estimate`), so the
# CLI shows the projected cost and asks before generating.
GEMINI_API_KEY=

# TikTok Content Posting API — OPTIONAL. Videos render to output/video/ without
# any of this; these only let shopagent push a render into your TikTok drafts.
# From an app at developers.tiktok.com with the video.upload scope. Note that
# Direct Post (publishing straight to your profile) additionally requires
# passing a TikTok audit, which they do not grant to internal tools — draft
# upload is what this supports, and it needs no audit.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
